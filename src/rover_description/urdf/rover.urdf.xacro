<?xml version="1.0"?>
<robot name="rover" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Dimensions (meters / kg) -->
  <xacro:property name="body_l" value="0.30"/>
  <xacro:property name="body_w" value="0.18"/>
  <xacro:property name="body_h" value="0.08"/>
  <xacro:property name="body_mass" value="2.0"/>
  <xacro:property name="wheel_r" value="0.04"/>
  <xacro:property name="wheel_w" value="0.03"/>
  <xacro:property name="wheel_mass" value="0.2"/>
  <xacro:property name="wheel_y" value="0.105"/>
  <xacro:property name="wheel_x" value="0.05"/>

  <material name="blue"><color rgba="0.1 0.3 0.8 1"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="red"><color rgba="0.8 0.1 0.1 1"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>

  <!-- Body -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${wheel_r + body_h/2}"/>
      <geometry><box size="${body_l} ${body_w} ${body_h}"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${wheel_r + body_h/2}"/>
      <geometry><box size="${body_l} ${body_w} ${body_h}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${wheel_r + body_h/2}"/>
      <mass value="${body_mass}"/>
      <inertia ixx="${body_mass/12*(body_w*body_w + body_h*body_h)}" ixy="0" ixz="0"
               iyy="${body_mass/12*(body_l*body_l + body_h*body_h)}" iyz="0"
               izz="${body_mass/12*(body_l*body_l + body_w*body_w)}"/>
    </inertial>
  </link>

  <!-- Wheel macro: write once, call twice -->
  <xacro:macro name="wheel" params="name y_pos">
    <link name="${name}">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_mass/12*(3*wheel_r*wheel_r + wheel_w*wheel_w)}" ixy="0" ixz="0"
                 iyy="${wheel_mass*wheel_r*wheel_r/2}" iyz="0"
                 izz="${wheel_mass/12*(3*wheel_r*wheel_r + wheel_w*wheel_w)}"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${wheel_x} ${y_pos} ${wheel_r}"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="wheel_left"  y_pos="${wheel_y}"/>
  <xacro:wheel name="wheel_right" y_pos="${-wheel_y}"/>

  <!-- Caster (rear ball) -->
  <link name="caster">
    <visual>
      <geometry><sphere radius="${wheel_r}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="${wheel_r}"/></geometry>
    </collision>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster"/>
    <origin xyz="${-body_l/2 + 0.04} 0 ${wheel_r}"/>
  </joint>

  <!-- Lidar (top of body) -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="red"/>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.05 0 ${wheel_r + body_h + 0.02}"/>
  </joint>

  <!-- Camera (front of body) -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.02 0.06 0.03"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${body_l/2} 0 ${wheel_r + body_h/2}"/>
  </joint>

  <!-- Gazebo settings (colors and friction) -->
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="wheel_left">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="wheel_right">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="caster">
    <material>Gazebo/Grey</material>
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <gazebo reference="lidar_link">
    <material>Gazebo/Red</material>
    <sensor name="lidar" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>6.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- Differential drive plugin: makes the wheels respond to /cmd_vel -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <update_rate>50</update_rate>
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>${2*wheel_y}</wheel_separation>
      <wheel_diameter>${2*wheel_r}</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>

</robot>